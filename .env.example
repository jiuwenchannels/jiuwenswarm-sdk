# JiuwenSwarm SDK — environment variables
#
# Copy this file to .env and fill in the values.
# Never commit a populated .env file to version control.
#
# Usage (Python SDK):
#   from openjiuwen.sdk.core.config import ModelConfig
#   cfg = ModelConfig.from_env()
#
# Usage (gateway server):
#   python -m openjiuwen.gateway  (reads JIUWENSWARM_GATEWAY_* vars at startup)

# ---------------------------------------------------------------------------
# LLM provider credentials (at least one required for in-process mode)
# ---------------------------------------------------------------------------

# Primary LLM API key — takes precedence over provider-specific keys below.
JIUWENSWARM_API_KEY=

# OpenAI API key — used when provider="openai" and JIUWENSWARM_API_KEY is not set.
OPENAI_API_KEY=sk-...

# Anthropic API key — used when provider="anthropic".
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Default model settings
# ---------------------------------------------------------------------------

# LLM provider name (default: openai). Options: openai, anthropic, etc.
JIUWENSWARM_PROVIDER=openai

# Default model name (default: gpt-4o).
JIUWENSWARM_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Remote / gateway connection (client-side)
# ---------------------------------------------------------------------------

# WebSocket server URL for Agent.connect() and @jiuwenswarm/sdk.
JIUWENSWARM_URL=ws://localhost:19000

# Bearer auth token for remote connections (optional in dev mode).
JIUWENSWARM_TOKEN=

# ---------------------------------------------------------------------------
# HTTP + WebSocket gateway server settings
# ---------------------------------------------------------------------------

# Bearer token required for all gateway requests. Leave unset to disable auth.
JIUWENSWARM_GATEWAY_TOKEN=

# Bind address for both servers (default: 0.0.0.0).
JIUWENSWARM_GATEWAY_HOST=0.0.0.0

# HTTP REST server port (default: 19001).
JIUWENSWARM_GATEWAY_PORT_REST=19001

# WebSocket server port (default: 19000).
JIUWENSWARM_GATEWAY_PORT_WS=19000
